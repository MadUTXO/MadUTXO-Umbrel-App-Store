diff --git a/src/daemon/attach.ts b/src/daemon/attach.ts
index 584ba6c..ecbf79a 100644
--- a/src/daemon/attach.ts
+++ b/src/daemon/attach.ts
@@ -34,7 +34,19 @@ export function runAttach(): never {
     process.exit(1);
   }
   const inner = tuiCommand(process.execPath, process.argv[1] ?? "");
-  // -A: attach if the session exists, otherwise create it and run the TUI.
-  const r = spawnSync("tmux", ["new-session", "-A", "-s", SESSION, inner], { stdio: "inherit" });
+  // Create the tmux session detached if it doesn't exist, so the TUI (and any
+  // in-progress download) keeps running after the ttyd client disconnects.
+  // Closing the browser tab only detaches; it never stops the engine.
+  if (spawnSync("tmux", ["has-session", "-t", SESSION], { stdio: "ignore" }).status !== 0) {
+    spawnSync("tmux", ["new-session", "-d", "-s", SESSION, inner]);
+  }
+  // Name the tmux window "TorLink" so the terminal title (and browser tab)
+  // shows the app name instead of the raw node command line. Applies to both
+  // new and existing sessions so upgrades pick it up.
+  spawnSync("tmux", ["rename-window", "-t", SESSION, "TorLink"]);
+  spawnSync("tmux", ["set-option", "-t", SESSION, "set-titles", "on"]);
+  spawnSync("tmux", ["set-option", "-t", SESSION, "set-titles-string", "TorLink"]);
+  // -d detaches other clients so this ttyd client can take over.
+  const r = spawnSync("tmux", ["attach-session", "-d", "-t", SESSION], { stdio: "inherit" });
   process.exit(r.status ?? 0);
 }
